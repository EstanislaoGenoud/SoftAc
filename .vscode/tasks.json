{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Frontend dev server",
			"type": "shell",
			"command": "npm.cmd",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Frontend dev server (correcto)",
			"type": "shell",
			"command": "npm.cmd --prefix frontend run dev -- --host 127.0.0.1",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}